# GEMINI_API_KEY: Optional/fallback key for Gemini API & embeddings (gemini-embedding-2).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# OPENROUTER_API_KEY: Primary OpenRouter API key for Smallville agent reasoning.
# Configure your secret key via Settings > Secrets (never commit real keys).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="z-ai/glm-5.3-flash"

# Provider routing & per-job model overrides
LLM_PROVIDER="auto"
# MODEL_CONVERSE=""
# MODEL_REFLECT=""
# MODEL_PLAN=""

# Security, persistence & cost limits
ENABLE_SERVER_SAVES="false"
MAX_LLM_CALLS_PER_DAY="10000"
# APP_ACCESS_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
